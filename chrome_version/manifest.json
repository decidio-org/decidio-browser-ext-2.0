{
  "manifest_version": 3,
  "name": "Decidio",
  "version": "1.0",
  "permissions": [
    "activeTab", 
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": { 
    "service_worker": "background.js" 
  },
  "action": { 
    "default_title": "Open Decidio Overlay",
    "default_icon": "decidio_logo.png" 
  },
  "icons": {
    "128": "decidio_logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html", 
        "panel_helper.js", 
        "decidio_logo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
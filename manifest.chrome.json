{
    "manifest_version": 3,
    "name": "decidio.",
    "version": "3.0",
    "permissions": [
      "tabs",
      "activeTab",
      "scripting",
      "storage"
    ],
    "host_permissions": [
      "https://decidio-api-production.up.railway.app/*",
      "<all_urls>"
    ],
    "action": { 
      "default_title": "decidio.",
      "default_icon": "default_logo.png" 
    },
    "icons": {
      "128": "default_logo.png"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": [
          "content.js"
        ]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["index.html", "style.css", "app.js"],
        "matches": ["<all_urls>"]
      }
    ]
}
{
    "manifest_version": 3,
    "name": "decidio.",
    "version": "2.0",
    "permissions": [
      "tabs",
      "activeTab",
      "scripting",
      "storage",
      "windows"
    ],
    "host_permissions": [
      "https://decidio-api-production.up.railway.app/*",
      "<all_urls>"
    ],
    "action": { 
      "default_popup": "popup.html",
      "default_title": "decidio.",
      "default_icon": "default_logo.png" 
    },
    "icons": {
      "128": "default_logo.png"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": [
          "drivers.js", 
          "util.js", 
          "requests.js",
          "components.js", 
          "content.js"
        ],
        "css": ["styles.css"],
        "run_at": "document_idle"
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["styles.css"],
        "matches": ["<all_urls>"]
      }
    ]
  }
{
  "manifest_version": 3,
  "name": "decidio.",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": { 
    "default_title": "decidio.",
    "default_icon": "default_logo.png" 
  },
  "icons": {
    "128": "default_logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
{
  "manifest_version": 3,
  "name": "Decidio",
  "version": "1.0",
  "description": "Overlays product information cards on sites.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "decidio.",
    "default_icon": "default_logo.png"
  },
  "icons": {
    "128": "default_logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["util.js", "drivers.js", "content.js", "components.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sample.json"],
      "matches": ["<all_urls>"]
    }
  ]
}